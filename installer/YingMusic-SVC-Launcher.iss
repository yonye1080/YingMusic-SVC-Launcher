; ============================================================
;  YingMusic-SVC-Launcher 1.0.0  --  Inno Setup 6 script
;
;  Build:
;    iscc /DPayloadDir="D:\YingMusic-SVC-Portable" ^
;         /DOutDir="D:\YingMusic-SVC-Installer\out" ^
;         YingMusic-SVC-Launcher.iss
;
;  Or simply: build_installer.bat
;
;  Design note: installed per-user (PrivilegesRequired=lowest) into
;  %LocalAppData%\Programs, NOT Program Files. The app writes
;  outputs\, timbre_library\ and ui_lang.json next to its own code,
;  which would fail under Program Files for a non-elevated user.
;
;  Assets:
;    assets\app.ico            generated by make_icon.py from
;                              assets\icon-source.png (256x256 RGBA)
;    ChineseSimplified.isl     user-contributed Inno Setup translation,
;                              see the header of that file for its source
;                              (needed because Inno Setup 6 only ships a
;                              handful of languages; Chinese is unofficial)
; ============================================================

#define MyAppName "YingMusic-SVC-Launcher"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "YingMusic-SVC contributors"
#define MyAppURL "https://github.com/yonye1080/YingMusic-SVC-Launcher"

#ifndef PayloadDir
  #define PayloadDir "D:\YingMusic-SVC-Portable"
#endif
#ifndef OutDir
  #define OutDir "D:\YingMusic-SVC-Installer\out"
#endif

[Setup]
AppId={{8F3C2B14-7E52-4A9D-9C1E-2D6A5B8E4F01}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
VersionInfoVersion={#MyAppVersion}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#OutDir}
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-Setup
Compression=lzma2/fast
SolidCompression=no
; The payload is ~8.4 GiB, far beyond the 2 GB single-exe limit,
; so disk spanning is mandatory. Result: setup.exe + setup-N.bin slices.
DiskSpanning=yes
DiskSliceSize=2000000000
WizardStyle=modern
SetupIconFile=assets\app.ico
UninstallDisplayName={#MyAppName} {#MyAppVersion}
UninstallDisplayIcon={app}\app.ico
AllowNoIcons=yes
; Roughly 8.2 GiB installed + room for generated audio
ExtraDiskSpaceRequired=0

[Languages]
; Listed first => preselected in the language dialog (also the default
; when the dialog is skipped). Chinese is the primary audience.
Name: "chinese"; MessagesFile: "ChineseSimplified.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[CustomMessages]
chinese.DeleteUserData=是否同时删除已生成的音频（outputs）与音色库（timbre_library）？
english.DeleteUserData=Delete the generated audio (outputs) and the voice library (timbre_library) as well?
chinese.ShortcutComment=YingMusic-SVC 歌声转换启动器
english.ShortcutComment=YingMusic-SVC singing voice conversion launcher

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
; App icon, used by the Start Menu / desktop shortcuts and by Add/Remove
; Programs. Kept outside the payload so the portable bundle stays icon-free.
Source: "assets\app.ico"; DestDir: "{app}"; Flags: ignoreversion
; Everything from the portable bundle. __pycache__/*.pyc are excluded:
; they are regenerated on first run and would add ~20k files / 245 MB.
Source: "{#PayloadDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "__pycache__,*.pyc,*.log"

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\start.bat"; WorkingDir: "{app}"; IconFilename: "{app}\app.ico"; Comment: "{cm:ShortcutComment}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\start.bat"; WorkingDir: "{app}"; IconFilename: "{app}\app.ico"; Comment: "{cm:ShortcutComment}"; Tasks: desktopicon

[Run]
Filename: "{app}\start.bat"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent shellexec

[UninstallDelete]
Type: files; Name: "{app}\ui_lang.json"
; __pycache__/.pyc and numba caches are created at runtime and are not
; tracked by the install log, so the Python tree has to go wholesale.
Type: filesandordirs; Name: "{app}\python"
; Insurance only: by the time this list is processed, {app} may still hold
; unins000.exe/.dat, so the empty-folder case is actually handled by Inno's
; own end-of-uninstall cleanup - see the note on usUninstall in [Code].
Type: dirifempty; Name: "{app}"
; start.bat points NUMBA_CACHE_DIR here (librosa/madmom JIT caches), which
; lives outside {app} and is therefore unknown to the uninstall log.
Type: filesandordirs; Name: "{localappdata}\{#MyAppName}"

[Code]
// Ask before removing user-generated data on uninstall.
//
// This runs on usUninstall (i.e. before the uninstaller starts deleting
// files), NOT on usPostUninstall. Order matters: [UninstallDelete] entries
// are processed before usPostUninstall, so deleting outputs\ there left an
// empty install folder behind - Inno's own end-of-uninstall cleanup had
// already run by then. Doing it first lets the normal cleanup finish the
// job and take the now-empty folder with it. Verified with a minimal
// payload: usPostUninstall => empty folder left; usUninstall => gone.
// (Comment style must be // here: a brace comment cannot contain "{app}".)
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  OutDir, TimbreDir: String;
begin
  if CurUninstallStep = usUninstall then
  begin
    OutDir := ExpandConstant('{app}\outputs');
    TimbreDir := ExpandConstant('{app}\timbre_library');
    if DirExists(OutDir) or DirExists(TimbreDir) then
    begin
      if MsgBox(ExpandConstant('{cm:DeleteUserData}'),
                mbConfirmation, MB_YESNO) = IDYES then
      begin
        DelTree(OutDir, True, True, True);
        DelTree(TimbreDir, True, True, True);
      end;
    end;
  end;
end;
